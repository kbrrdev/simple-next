# Public: built into the bundle, so never put secrets here.
# The simple-express API. Its CORS_ORIGINS must include this app's address.
NEXT_PUBLIC_API_URL=http://localhost:3000
# This storefront's own address, used in the sitemap and links shared on social media.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Shown in the header and page titles. Defaults to "Store".
# NEXT_PUBLIC_STORE_NAME=
# The public address of uploaded images when the API stores them in S3, matching the
# API's S3_PUBLIC_URL. Leave it unset when the API serves them from /uploads.
# NEXT_PUBLIC_IMAGE_URL=

# Server only: the API's address for the Next.js server, such as an internal address.
# Defaults to NEXT_PUBLIC_API_URL.
# API_URL=

    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
